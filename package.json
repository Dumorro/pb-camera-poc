{
  "name": "pb-camera-poc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:wasm": "cd wasm && source $HOME/.cargo/env && wasm-pack build --target web --out-dir ../src/lib/wasm-pkg",
    "build:opencv": "node -e \"const fs=require('fs');fs.mkdirSync('public/opencv',{recursive:true});fs.copyFileSync('node_modules/@techstark/opencv-js/dist/opencv.js','public/opencv/opencv.js');console.log('opencv.js copied')\"",
    "prebuild": "npm run build:opencv",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@techstark/opencv-js": "^4.12.0-release.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.21.1"
  }
}
